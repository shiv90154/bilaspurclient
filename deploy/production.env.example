# EduManage production settings.
# ./deploy/deploy.sh init  creates deploy/production.env from this, with random secrets filled in.
# The real file (production.env) is git-ignored: never commit it.

# ── Public addresses (DNS A records must point at this server) ──
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# ── Host ports (only these two; picked automatically if busy) ──
# BIND_ADDR 127.0.0.1 = reachable only from this server (use with Nginx installed on the host).
# If your Nginx itself runs in Docker, set it to the Docker bridge gateway, usually 172.17.0.1.
BIND_ADDR=127.0.0.1
WEB_PORT=18480
API_PORT=18481

# ── Database (never published on the host) ──
POSTGRES_USER=edumanage
POSTGRES_DB=edumanage
POSTGRES_PASSWORD=__generated__

# ── Auth ──
JWT_ACCESS_SECRET=__generated__

# ── First admin (created once on first deploy; changing it later does not reset the password) ──
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=__set_a_real_phone__
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__generated__
# Demo course/batch/students/faculty with well-known passwords. Keep false on a real server.
SEED_DEMO=false

# ── Push notifications (FCM), optional ──
# The Firebase service-account key as ONE line in single quotes. Build the line with:
#   node -e "console.log(\"FIREBASE_SERVICE_ACCOUNT_JSON='\"+JSON.stringify(require('./backend/firebase-service-account.json'))+\"'\")" >> deploy/production.env
# Leave unset to run without push.

# ── Backups ──
# Set a long random passphrase to encrypt the daily backups (AES-256). Store a copy somewhere
# safe and separate: without it the backups cannot be restored. Example: openssl rand -hex 32
BACKUP_PASSPHRASE=

# ── Email (OTP for registration and forgot password) ──
# From your mail provider (Hostinger mail, Zoho, Gmail app password, Brevo ...). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Online fees on the website (Razorpay) ──
# Razorpay dashboard > Account & Settings > API Keys (rzp_test_... while testing, rzp_live_... after KYC).
# Webhook: URL https://<api-domain>/api/payments/razorpay/webhook, events payment.captured + order.paid,
# and the secret you type there goes in RAZORPAY_WEBHOOK_SECRET. Empty keys = online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Zoom class recordings → Recorded videos (docs/14-zoom-recordings.md) ──
# Needs Zoom Pro (cloud recording). marketplace.zoom.us > Develop > Build App > Server-to-Server OAuth:
# Account ID, Client ID, Client Secret. Scopes (search in the Scopes tab): list a meeting's recording
# files, list past meeting instances, and delete recordings (only if ZOOM_TRASH_AFTER_IMPORT=true).
# Event Subscriptions: URL https://<api-domain>/api/integrations/zoom/webhook, event "All Recordings
# have completed"; its Secret Token goes in ZOOM_WEBHOOK_SECRET. Empty = Zoom import off.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
# true = after copying, move the recording to Zoom's trash (kept 30 days) so the 5GB never fills.
ZOOM_TRASH_AFTER_IMPORT=false

# ── Where recordings are kept ──
# local = this server's storage volume (free, uses disk: ~0.5-1 GB per hour of class).
# r2 = Cloudflare R2 (10 GB free, no bandwidth charges). Dashboard > R2 > create a private bucket >
# Manage API tokens > "Object Read & Write" on that bucket. Old videos stay where they were saved.
VIDEO_STORE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
