NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d db  → see ../docker-compose.yml)
DATABASE_URL=postgresql://edumanage:edumanage@localhost:5433/edumanage?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Comma separated list of allowed web origins (admin-web / student web)
CORS_ORIGINS=http://localhost:3001

# Security rules
DEVICE_CHANGE_LIMIT_30D=3
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Swagger UI at /api/docs (keep false in production)
SWAGGER_ENABLED=true

# First admin (used by `npm run db:seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
# Set true to also create demo course/batch/faculty/student for testing
SEED_DEMO=true

# Uploaded files (private, served only via signed links)
STORAGE_DIR=./storage
